/// CVM Experiments: customer lifecycle (UCI Online Retail II) and a randomised offer test (MineThatData) in one model.
model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table Month
ref table Customer
ref table Flow
ref table 'Customer Month'
ref table 'Cohort Activity'
ref table 'Churn Scores'
ref table 'Churn Drivers'
ref table 'Model Metrics'
ref table 'Email Test'
ref table 'Test Arm'
ref table Policies
ref table 'Targeting Curve'
ref table 'Decile Check'
ref table 'Target Share'
ref table 'Contact Cost'
ref table KPI
ref table 'Uplift by'

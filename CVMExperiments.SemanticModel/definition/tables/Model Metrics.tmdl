/// ML evaluation metrics.
table 'Model Metrics'
	isHidden

	column Metric
		dataType: string
		summarizeBy: none
		sourceColumn: Metric

	column Value
		dataType: double
		isHidden
		formatString: 0.####
		summarizeBy: none
		sourceColumn: Value

	partition 'Model Metrics' = m
		mode: import
		source =
				let
				    Source = fnLoadCsv("model_metrics.csv"),
				    Typed = Table.TransformColumnTypes(Source, {{"Metric", type text}, {"Value", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
